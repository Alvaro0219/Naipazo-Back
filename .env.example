# Runtime
NODE_ENV=development
PORT=4000

# Database — MongoDB con replica set (Atlas ya lo es). Las fichas usan transacciones.
MONGO_URL=mongodb+srv://USUARIO:PASSWORD@CLUSTER.mongodb.net/truco_db?retryWrites=true&w=majority
# Opcional: base separada para los tests de integración (wallet/auth). Si no está, esos tests se saltean.
# ¡Ojo! Los tests borran las colecciones de esta base.
MONGO_URL_TEST=

# Auth
JWT_SECRET=change_me_please_16+
JWT_EXPIRES_IN=1d
REFRESH_SECRET=change_me_refresh_16+
REFRESH_EXPIRES_IN=7d

# CORS (también aplica a Socket.IO). Separar con comas.
CORS_ORIGINS=http://localhost:5173

# Fichas y juego
DAILY_GRANT_AMOUNT=1000
APP_TIMEZONE=America/Argentina/Buenos_Aires
MIN_BET=10
MAX_BET=10000
HOUSE_RATE=0
TURN_TIMEOUT_SECONDS=20
RECONNECT_GRACE_SECONDS=60

# Revancha y torneos (M7)
REMATCH_WINDOW_SECONDS=60
TOURNAMENT_NEXT_MATCH_SECONDS=10

# Cuentas (P4). Proveedor: Resend. Sin EMAIL_API_KEY los emails se escriben en la consola.
EMAIL_API_KEY=
EMAIL_FROM=Naipazo <no-responder@tu-dominio.com>
APP_URL=http://localhost:5173
# Crédito diario solo con email verificado. Por defecto: true en producción, false en desarrollo.
REQUIRE_EMAIL_VERIFICATION=false

# Integridad de fichas (P5)
REGISTER_MAX_PER_IP_PER_DAY=10
PRIVATE_MAX_BET=1000

# Vencimientos (P6)
ROOM_WAITING_TTL_MINUTES=10
TOURNAMENT_WAITING_TTL_MINUTES=30
