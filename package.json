{
  "name": "truco-back",
  "version": "0.1.0",
  "private": true,
  "description": "Backend de Truco Online (Fase 1 — fichas virtuales)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/app.js",
    "start": "NODE_ENV=production node src/app.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "make-admin": "node scripts/makeAdmin.js",
    "rules:trace": "node scripts/check-rule-ids.mjs",
    "rules:matrix": "node scripts/render-matrix.mjs",
    "test:coverage": "vitest run src/game --coverage",
    "test:nightly": "cross-env PROPS_RUNS=1000000 SIM_MATCHES=100000 vitest run src/game",
    "test:mutation": "stryker run",
    "test:shuffle": "node scripts/shuffle-stats.mjs"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^7.1.0",
    "joi": "^17.12.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.3.1",
    "morgan": "^1.10.0",
    "socket.io": "^4.8.4",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "cross-env": "^10.1.0",
    "fast-check": "^4.10.2",
    "socket.io-client": "^4.8.1",
    "vitest": "^3.2.4"
  }
}
